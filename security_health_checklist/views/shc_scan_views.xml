<odoo>
    <record id="view_shc_scan_list" model="ir.ui.view">
        <field name="name">shc.scan.list</field>
        <field name="model">shc.scan</field>
        <field name="arch" type="xml">
            <list string="Scans" decoration-danger="grade in ('E','F')" decoration-warning="grade in ('C','D')" decoration-success="grade in ('A','B')">
                <field name="name" decoration-bf="1"/>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="score" widget="progressbar"/>
                <field name="grade" widget="badge"
                       decoration-success="grade in ('A','B')"
                       decoration-warning="grade == 'C'"
                       decoration-danger="grade in ('D','E','F')"/>
                <field name="score_delta" widget="badge"
                       decoration-success="score_delta &gt; 0"
                       decoration-danger="score_delta &lt; 0"
                       decoration-muted="score_delta == 0"/>
                <field name="count_critical" decoration-danger="count_critical &gt; 0" optional="show"/>
                <field name="count_high" decoration-warning="count_high &gt; 0" optional="show"/>
                <field name="count_medium" optional="hide"/>
                <field name="count_low" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'running'" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_shc_scan_form" model="ir.ui.view">
        <field name="name">shc.scan.form</field>
        <field name="model">shc.scan</field>
        <field name="arch" type="xml">
            <form string="Healthcheck" class="shc_scan_form">
                <header>
                    <button name="action_print" type="object" string="Print" class="btn-primary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="running,done,failed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Scan</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="shc_dashboard_container mb-4">
                        <!-- Top Summary Row: Score, Trend/Delta, Severity Counts -->
                        <div class="row g-3 align-items-stretch">
                            <!-- Overall Score Card -->
                            <div class="col-lg-3 col-md-6 col-12">
                                <div class="shc_hero_card">
                                    <div class="shc_card_label">Overall Security Score</div>
                                    <div class="shc_hero_score_ring">
                                        <span class="shc_hero_score_val"><field name="score" widget="float" digits="[3,1]"/></span>
                                        <span class="shc_hero_score_max">/100</span>
                                    </div>
                                    <div class="shc_hero_grade mt-2">
                                        <field name="grade" widget="badge"
                                               decoration-success="grade in ('A','B')"
                                               decoration-warning="grade == 'C'"
                                               decoration-danger="grade in ('D','E','F')"/>
                                    </div>
                                    <div class="shc_hero_cap_warning" invisible="not capped">
                                        <i class="fa fa-shield me-1"/>Capped at C (Critical Failed)
                                    </div>
                                </div>
                            </div>

                            <!-- Scan Meta Info Card -->
                            <div class="col-lg-3 col-md-6 col-12">
                                <div class="shc_meta_card">
                                    <div class="shc_card_label">Scan Summary</div>
                                    <div class="shc_meta_item">
                                        <span class="shc_meta_key"><i class="fa fa-calendar me-1"/>Date:</span>
                                        <span class="shc_meta_val"><field name="date"/></span>
                                    </div>
                                    <div class="shc_meta_item">
                                        <span class="shc_meta_key"><i class="fa fa-user me-1"/>Inspector:</span>
                                        <span class="shc_meta_val"><field name="user_id" widget="many2one_avatar_user"/></span>
                                    </div>
                                    <div class="shc_meta_item">
                                        <span class="shc_meta_key"><i class="fa fa-server me-1"/>Platform:</span>
                                        <span class="shc_meta_val"><field name="odoo_version"/> (<field name="odoo_edition"/>)</span>
                                    </div>
                                    <div class="shc_meta_item">
                                        <span class="shc_meta_key"><i class="fa fa-line-chart me-1"/>Score Delta:</span>
                                        <span class="shc_meta_val">
                                            <field name="score_delta" widget="badge"
                                                   decoration-success="score_delta &gt; 0"
                                                   decoration-danger="score_delta &lt; 0"
                                                   decoration-muted="score_delta == 0"/>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Severity Breakdown KPI Cards (2x2 Grid) -->
                            <div class="col-lg-6 col-md-12 col-12">
                                <div class="row g-2 h-100">
                                    <div class="col-sm-6 col-12">
                                        <div class="shc_stat_card shc_stat_critical h-100">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="shc_stat_title"><i class="fa fa-times-circle me-1"/>Critical Findings</div>
                                                <div class="shc_stat_num"><field name="count_critical"/></div>
                                            </div>
                                            <div class="shc_stat_subtext">Urgent vulnerabilities requiring immediate fix</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <div class="shc_stat_card shc_stat_high h-100">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="shc_stat_title"><i class="fa fa-exclamation-triangle me-1"/>High Risk</div>
                                                <div class="shc_stat_num"><field name="count_high"/></div>
                                            </div>
                                            <div class="shc_stat_subtext">Significant security flaws or policy violations</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <div class="shc_stat_card shc_stat_medium h-100">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="shc_stat_title"><i class="fa fa-exclamation-circle me-1"/>Medium Risk</div>
                                                <div class="shc_stat_num"><field name="count_medium"/></div>
                                            </div>
                                            <div class="shc_stat_subtext">Best practice and hardening opportunities</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <div class="shc_stat_card shc_stat_low h-100">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="shc_stat_title"><i class="fa fa-info-circle me-1"/>Low / Info</div>
                                                <div class="shc_stat_num"><field name="count_low"/></div>
                                            </div>
                                            <div class="shc_stat_subtext">Minor optimizations and general insights</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Areas Progress Breakdown Row -->
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="shc_areas_card">
                                    <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                        <div class="shc_card_label mb-0">Domain Security Breakdown</div>
                                        <div class="text-muted small"><i class="fa fa-info-circle me-1"/>Weighted performance per evaluation pillar</div>
                                    </div>
                                    <field name="area_score_ids" nolabel="1">
                                        <list decoration-muted="is_na" decoration-success="grade in ('A','B')" decoration-warning="grade == 'C'" decoration-danger="grade in ('D','E','F')">
                                            <field name="area" string="Evaluation Domain"/>
                                            <field name="score" widget="progressbar" string="Score (%)"/>
                                            <field name="grade" widget="badge" string="Grade"
                                                   decoration-success="grade in ('A','B')"
                                                   decoration-warning="grade == 'C'"
                                                   decoration-danger="grade in ('D','E','F')"/>
                                            <field name="weight" widget="float" digits="[2,2]" string="Impact Weight"/>
                                            <field name="is_na" optional="hide"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>
                    <group string="Audit &amp; Environment Details" class="mt-2">
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="duration" string="Scan Duration (seconds)"/>
                        </group>
                        <group>
                            <field name="environment"/>
                            <field name="previous_scan_id"/>
                            <field name="capped" invisible="not capped"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Findings" name="findings">
                            <field name="finding_ids" nolabel="1" context="{'tree_view_ref': 'security_health_checklist.view_shc_scan_result_list', 'list_view_ref': 'security_health_checklist.view_shc_scan_result_list'}">
                                <list decoration-danger="status == 'failed' and severity in ('critical','high')"
                                      decoration-warning="status in ('warning','failed') and severity in ('medium','low')"
                                      decoration-muted="status in ('accepted','error','na')"
                                      decoration-info="status == 'passed'">
                                    <field name="code"/>
                                    <field name="title"/>
                                    <field name="area"/>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity == 'critical'"
                                           decoration-warning="severity == 'high'"
                                           decoration-info="severity == 'medium'"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'passed'"
                                           decoration-danger="status == 'failed'"
                                           decoration-warning="status == 'warning'"/>
                                    <field name="affected_count"/>
                                    <button name="action_open_affected" type="object" string="Open records" icon="fa-external-link" invisible="not show_affected"/>
                                    <field name="show_affected" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="All checks" name="all_checks">
                            <field name="result_ids" nolabel="1">
                                <list>
                                    <field name="code"/>
                                    <field name="title"/>
                                    <field name="area"/>
                                    <field name="severity"/>
                                    <field name="status"/>
                                    <field name="penalty" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Compared with previous" name="compare">
                            <group>
                                <field name="new_finding_codes"/>
                                <field name="resolved_finding_codes"/>
                            </group>
                            <p class="text-muted">
                                Newly introduced findings are checks that failed or warned on this scan but not on the previous one.
                                Resolved findings went the other way.
                            </p>
                        </page>
                        <page string="Methodology" name="method">
                            <field name="methodology_note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_shc_scan_search" model="ir.ui.view">
        <field name="name">shc.scan.search</field>
        <field name="model">shc.scan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="grade"/>
                <filter string="Grade A" name="grade_a" domain="[('grade', '=', 'A')]"/>
                <filter string="Grade B" name="grade_b" domain="[('grade', '=', 'B')]"/>
                <filter string="Grade C" name="grade_c" domain="[('grade', '=', 'C')]"/>
                <filter string="Grade D–F" name="grade_low" domain="[('grade', 'in', ['D','E','F'])]"/>
                <separator/>
                <filter string="This month" name="this_month" domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Grade" name="group_grade" context="{'group_by': 'grade'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_shc_scan_graph" model="ir.ui.view">
        <field name="name">shc.scan.graph</field>
        <field name="model">shc.scan</field>
        <field name="arch" type="xml">
            <graph string="Score trend" type="line">
                <field name="date" interval="day"/>
                <field name="score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_shc_scan_pivot" model="ir.ui.view">
        <field name="name">shc.scan.pivot</field>
        <field name="model">shc.scan</field>
        <field name="arch" type="xml">
            <pivot string="Scans by grade">
                <field name="grade" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_shc_scan" model="ir.actions.act_window">
        <field name="name">History</field>
        <field name="res_model">shc.scan</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_this_month': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No scans yet</p>
            <p>Run a healthcheck from the menu to create the first scan.</p>
        </field>
    </record>
</odoo>
