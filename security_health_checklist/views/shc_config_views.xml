<odoo>
    <record id="view_shc_check_config_tree" model="ir.ui.view">
        <field name="name">shc.check.config.tree</field>
        <field name="model">shc.check.config</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="code"/>
                <field name="title"/>
                <field name="area"/>
                <field name="severity"/>
                <field name="active"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="view_shc_check_config_form" model="ir.ui.view">
        <field name="name">shc.check.config.form</field>
        <field name="model">shc.check.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="title"/>
                        <field name="area"/>
                        <field name="severity"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shc_check_config" model="ir.actions.act_window">
        <field name="name">Checks</field>
        <field name="res_model">shc.check.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_shc_accepted_risk_tree" model="ir.ui.view">
        <field name="name">shc.accepted.risk.tree</field>
        <field name="model">shc.accepted.risk</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="res_key"/>
                <field name="justification"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="expiry_date"/>
            </tree>
        </field>
    </record>

    <record id="view_shc_accepted_risk_form" model="ir.ui.view">
        <field name="name">shc.accepted.risk.form</field>
        <field name="model">shc.accepted.risk</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="res_key"/>
                        <field name="justification"/>
                        <field name="user_id"/>
                        <field name="date"/>
                        <field name="expiry_date"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shc_accepted_risk" model="ir.actions.act_window">
        <field name="name">Accepted risks</field>
        <field name="res_model">shc.accepted.risk</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_res_config_settings_shc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.shc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Security Healthcheck" string="Security Healthcheck" name="security_health_checklist" groups="base.group_system">
                    <block title="Thresholds" name="shc_thresholds">
                        <setting string="Administrator count threshold" help="AUTH-04 fails when the number of Settings users is above this value.">
                            <field name="shc_admin_threshold"/>
                        </setting>
                        <setting string="Dormant days" help="Settings users with no login for this many days are flagged.">
                            <field name="shc_dormant_days"/>
                        </setting>
                        <setting string="API key age (days)" help="API keys older than this are flagged.">
                            <field name="shc_api_key_max_age_days"/>
                        </setting>
                    </block>
                    <block title="History and schedule" name="shc_history">
                        <setting string="Retention (months)" help="Delete scans older than this many months. 0 keeps all scans.">
                            <field name="shc_retention_months"/>
                        </setting>
                        <setting string="Notify after scheduled scan" help="Chatter notification if the grade drops or a new critical finding appears. Mail is sent only if outgoing mail is already configured.">
                            <field name="shc_notify_user_ids" widget="many2many_tags"/>
                        </setting>
                    </block>
                    <block title="Detection lists" name="shc_lists">
                        <setting string="Known brute-force modules" help="Comma-separated technical names used by AUTH-09.">
                            <field name="shc_bruteforce_modules"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_shc_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'security_health_checklist', 'bin_size': False}</field>
    </record>
</odoo>
