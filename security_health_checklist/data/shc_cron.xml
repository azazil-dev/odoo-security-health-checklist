<odoo noupdate="1">
    <record id="ir_cron_shc_weekly" model="ir.cron">
        <field name="name">Security Healthcheck: weekly scan</field>
        <field name="model_id" ref="model_shc_scan"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_scan()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="False"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
